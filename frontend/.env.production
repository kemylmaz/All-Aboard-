# Demo dalinin kimligi: oyun backend olmadan, misafir modunda derlenir.
# Next NEXT_PUBLIC_* degiskenlerini derleme aninda koda gomer; Cloudflare'in
# "Variables and secrets" bolumu ise calisma zamani icindir ve bu bayrak oraya
# yazilinca build'e ulasmaz. Bu yuzden bayrak panelde degil, burada duruyor.
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_APP_VERSION=demo
